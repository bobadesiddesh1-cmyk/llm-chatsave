{
  "manifest_version": 3,
  "name": "Threadkeeper — Export Your AI Conversations",
  "version": "2.0.0",
  "description": "Export & archive ChatGPT, Claude and Gemini chats. Search every AI conversation in one private, on-device library. 100% local.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Threadkeeper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "shared/base64.js",
        "shared/idle-chunk.js",
        "shared/storage.js",
        "content/adapters/chatgpt.js",
        "content/adapters/claude.js",
        "content/adapters/gemini.js",
        "content/extractor.js",
        "render/markdown.js",
        "render/html.js",
        "render/pdf.js",
        "content/export-button.js",
        "content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
